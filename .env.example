# Database Configuration (PostgreSQL)
# Replace with your PostgreSQL connection URL (e.g., local PostgreSQL, Supabase, Neon, Railway)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/inertiahub?schema=public"

# Authentication & Security
JWT_SECRET="inertiahub_super_secret_jwt_encryption_key_production_grade_2026"
# HMAC key for short-lived script download tokens (keep secret!)
SCRIPT_HMAC_KEY="change-me-to-a-long-random-base64-string"
SESSION_EXPIRY_DAYS=7

# Application URLs & Ports
NEXT_PUBLIC_APP_URL="http://localhost:3000"
PORT=3000
NODE_ENV="development"

# Initial Superadmin Credentials (used during prisma db seed)
ADMIN_INIT_EMAIL="admin@inertiahub.com"
ADMIN_INIT_PASSWORD="InertiaAdmin2026!"
ADMIN_INIT_NAME="InertiaHub Superadmin"

# Email (SMTP) - used to send login codes for ADMIN/EDITOR accounts
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="you@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="you@gmail.com"

# Comma-separated IPs allowed to access /admin and admin APIs
ALLOWED_ADMIN_IPS="1.2.3.4"

# Media Storage Configuration
UPLOAD_MAX_FILE_SIZE_MB=15
UPLOAD_DIRECTORY="public/uploads"
